# Shared setup; every child is still an independently configurable project.
get_filename_component(CCC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(TEST_STANDARD 20 CACHE STRING "Scenario C++ standard")
set(TEST_BACKEND 0 CACHE STRING "Scenario formatting backend")
set(TEST_IMPORT header CACHE STRING "header, module, aggregate or mixed")
set(TEST_CONFIG "" CACHE STRING "Configuration path relative to test/tassert")
set(TEST_DEFINES "" CACHE STRING "Additional scenario definitions")
set(CMAKE_CXX_STANDARD ${TEST_STANDARD})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_BINARY_DIR}/bin")

if (TEST_IMPORT STREQUAL "header")
    set(CCC_USE_CPP_MODULES OFF CACHE BOOL "" FORCE)
else ()
    set(CCC_USE_CPP_MODULES ON CACHE BOOL "" FORCE)
endif ()
if (NOT TEST_NEGATIVE OR TEST_BACKEND STREQUAL "2")
    if (TEST_INSTALLED)
        find_package(ccc CONFIG REQUIRED)
        if (TEST_CONFIG)
            get_filename_component(testConfigDirectory "${TEST_CONFIG}" DIRECTORY)
            target_include_directories(ccc::ccc INTERFACE "${CMAKE_CURRENT_LIST_DIR}/${testConfigDirectory}")
        endif ()
    else ()
        if (TEST_BACKEND STREQUAL "auto")
            set(CCC_TASSERT_FORMAT_BACKEND "" CACHE STRING "" FORCE)
        else ()
            set(CCC_TASSERT_FORMAT_BACKEND "${TEST_BACKEND}" CACHE STRING "" FORCE)
        endif ()
        if (TEST_CONFIG)
            get_filename_component(testConfigHeader "${TEST_CONFIG}" ABSOLUTE
                BASE_DIR "${CMAKE_CURRENT_LIST_DIR}")
            set(CCC_TASSERT_CONFIG_HEADER "${testConfigHeader}" CACHE FILEPATH "" FORCE)
        else ()
            set(CCC_TASSERT_CONFIG_HEADER "" CACHE FILEPATH "" FORCE)
        endif ()
        if (TEST_BACKEND STREQUAL "2")
            include("${CMAKE_CURRENT_LIST_DIR}/fmt.cmake")
        endif ()
        add_subdirectory("${CCC_ROOT}" ccc)
    endif ()
endif ()

add_executable(test ${TEST_SOURCES})
if (TEST_NEGATIVE)
    target_include_directories(test PRIVATE "${CCC_ROOT}/include")
    if (TARGET fmt::fmt)
        target_link_libraries(test PRIVATE fmt::fmt)
    endif ()
    target_compile_definitions(test PRIVATE CCC_TASSERT_FORMAT_BACKEND=${TEST_BACKEND})
    if (TEST_CONFIG)
        target_compile_definitions(test PRIVATE
            "CCC_TASSERT_CONFIG_HEADER=\"${CMAKE_CURRENT_LIST_DIR}/${TEST_CONFIG}\"")
    endif ()
else ()
    target_link_libraries(test PRIVATE ccc::ccc)
endif ()
find_package(Threads REQUIRED)
target_link_libraries(test PRIVATE Threads::Threads)
target_compile_definitions(test PRIVATE ${TEST_DEFINES})
if (TEST_BACKEND GREATER 0)
    target_compile_definitions(test PRIVATE TEST_FORMAT=1 TEST_FORMAT_BACKEND=${TEST_BACKEND})
endif ()
if (TEST_IMPORT STREQUAL "aggregate")
    target_compile_definitions(test PRIVATE TEST_IMPORT_ALL=1)
elseif (NOT TEST_IMPORT STREQUAL "header")
    target_compile_definitions(test PRIVATE TEST_IMPORT_TASSERT=1)
endif ()
if (TEST_IMPORT STREQUAL "mixed")
    target_compile_definitions(test PRIVATE TEST_MIXED=1)
endif ()
if (MSVC)
    target_compile_options(test PRIVATE /W4 /WX /Zc:__cplusplus)
else ()
    target_compile_options(test PRIVATE -Wall -Wextra -Wpedantic -Werror)
endif ()

add_executable(exit_failure "${CMAKE_CURRENT_LIST_DIR}/exit_failure.cc")

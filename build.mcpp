#include <filesystem>
#include <fstream>

import mcpp;

int main()
{
    namespace fs = std::filesystem;

    const fs::path src_dir = "modules";
    const fs::path dst_dir = "generated/modules";
    fs::create_directories(dst_dir);

    // Clear the generated .cppm shim to avoid leaving ghost modules after deleting .ccm
    for (const auto& entry : fs::recursive_directory_iterator(dst_dir)) {
        if (!entry.is_regular_file()) {
            continue;
        }
        const auto& p = entry.path();
        if (p.extension().string() == ".cppm") {
            fs::remove(p);
        }
    }

    for (const auto& entry : fs::recursive_directory_iterator(src_dir)) {
        if (!entry.is_regular_file()) {
            continue;
        }
        const auto& src = entry.path();
        if (src.extension().string() != ".ccm") {
            continue;
        }
        auto rel = fs::relative(src, src_dir);
        auto dst = dst_dir / rel;
        dst.replace_extension(".cppm");
        fs::create_directories(dst.parent_path());
        {
            std::ifstream in(src, std::ios::binary);
            std::ofstream out(dst, std::ios::binary | std::ios::trunc);
            out << in.rdbuf();
        }
        mcpp::rerun_if_changed(src.generic_string().c_str());
    }
    return 0;
}
